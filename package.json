{
  "name": "urban-tanker-ops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:customer": "vite --mode customer --host 0.0.0.0",
    "dev:vendor": "vite --mode vendor --host 0.0.0.0",
    "dev:admin": "vite --mode admin --host 0.0.0.0",
    "dev:local": "vite",
    "dev:all": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors blue,green \"npm --prefix backend run dev\" \"npm run dev\"",
    "build:all": "npm run typecheck && npm run build && npm --prefix backend run build",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "firebase": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "sass": "latest",
    "typescript": "latest",
    "concurrently": "^9.2.1",
    "typescript-eslint": "latest"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "protobufjs@7.6.6": true
  }
}
