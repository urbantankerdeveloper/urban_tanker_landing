# Backend API Configuration
# Used only by local development. Deployed builds use the current browser domain.
VITE_API_BASE_URL=http://localhost:5000

# Google sign-in configuration
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Customer/tenant content configuration
# Each customer gets: customers/{VITE_CONTENT_CLIENT_ID}/content/config
VITE_CONTENT_CLIENT_ID=urban-tanker

# Platform integrations
VITE_CITY_CODE=chennai
VITE_SENTRY_DSN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Backend integrations
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
BACKUP_RETENTION_DAYS=30
VENDOR_DISPATCH_RADIUS_KM=25
VITE_ENABLE_VENDOR_WORKFORCE_FEATURES=false

# Admin Dashboard Controls
VITE_ENABLE_DISPATCH_BOARD=false
VITE_ENABLE_GOOGLE_AUTH=false
