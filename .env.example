# Backend API Configuration
VITE_API_BASE_URL=http://localhost:5000

# Firebase Realtime Database
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
VITE_AUTH_FUNCTION_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/signInWithDatabaseCredentials
VITE_REGISTER_FUNCTION_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/registerWithDatabaseCredentials

# Customer/tenant content configuration
# Each customer gets: customers/{VITE_CONTENT_CLIENT_ID}/content/config
VITE_CONTENT_CLIENT_ID=urban-tanker
